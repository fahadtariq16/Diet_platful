# Copy this file to .env and change the values.
PORT=4000
# Use a long random string in production, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
# Where the SQLite database file lives
DB_PATH=./data/plateful.db
# Only needed if the React app is served from a different origin than the API
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
